# ───────────────────────── Compilación ─────────────────────────
.build/
.swiftpm/
DerivedData/
/fotos-iphone
/*.app
/*.bundle
*.log

# ──────────── Datos personales que genera la herramienta ────────────
# Informes y volcados: nombres, fechas, tamaños y huellas de tus fotos.
*.csv
# Listas del álbum generadas por el Atajo.
*.txt
# Manifiesto de lo copiado (fase 3) y carpetas temporales de la copia.
manifiesto*.json
.fotos-iphone/
.temporal-fotos-iphone/
# Perfiles y caché exportados por error dentro del proyecto
# (normalmente viven en ~/Library/Application Support/fotos-iphone/).
perfiles/
cache/

# ───────── Fotos y vídeos, por si alguno acaba en el proyecto ─────────
